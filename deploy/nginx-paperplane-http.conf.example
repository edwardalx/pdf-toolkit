# Temporary HTTP-only site used to obtain the app's Let's Encrypt certificate.
# Replace this with nginx-paperplane.conf.example after the certificate exists.
server {
    listen 80;
    server_name pdf-converter.duckdns.org;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
