# Temporary HTTP-only site used to obtain the app's Let's Encrypt certificate.
# Replace this with nginx-paperplane.conf.example after the certificate exists.
server {
    listen 80;
    server_name pdf-gh.giize.com;

    location / {
        proxy_pass http://paperplane:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
