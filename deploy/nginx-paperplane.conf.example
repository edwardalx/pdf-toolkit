# Install as a separate Nginx site. It must not reuse the Bookshelf server_name.

server {
    listen 80;
    server_name pdf-converter.duckdns.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pdf-converter.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/pdf-converter.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pdf-converter.duckdns.org/privkey.pem;

    client_max_body_size 2g;

    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
